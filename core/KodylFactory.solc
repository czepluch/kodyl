// KodylFactory, ported from src/KodylFactory.sol to Core Solidity as a
// REGISTRY (deviation 1): the language cannot yet deploy a contract from a
// contract (no initcode access), so createEvent is replaced by
// validateEventParameters + registerEvent over externally-deployed events.
//
// InvalidEventParameters(string) reverts are byte-identical to the Solidity
// original; reason strings are precomputed packed words because string
// literals are compile-time-only in Core Solidity.
import std.{*};
import std.opcodes.{shr, mstore, mload};
import std.dispatch.{*};
import lib.kodyl.{*};

function readUintFrom(target : address, sel : bytes32) -> uint256 {
    return uint256(readWordFrom(target, sel));
}

function readAddrFrom(target : address, sel : bytes32) -> address {
    return address(readWordFrom(target, sel));
}

// revert InvalidEventParameters("Zero address")
function revertZeroAddress() -> () {
    revertStr1(shr(224, keccakLit("InvalidEventParameters(string)")), 12,
               0x5a65726f20616464726573730000000000000000000000000000000000000000);
}

contract KodylFactory {
    maintainer : address;
    eventCount : uint256;
    // Named eventsArr / isKodylEventMap so the public getters events() and
    // isKodylEvent() never index a field sharing their own name.
    eventsArr : array(address);
    isKodylEventMap : mapping(address, bool);

    constructor(maintainer_ : address) {
        if (Typedef.rep(maintainer_) == 0) {
            revertZeroAddress();
        }
        maintainer = maintainer_;
    }

    // --- getters ---

    public function maintainer() -> address { return maintainer; }
    public function eventCount() -> uint256 { return eventCount; }
    public function events(i : uint256) -> address { return eventsArr[i]; }
    public function isKodylEvent(a : address) -> bool { return isKodylEventMap[a]; }
    public function MIN_CANCELLATION_BUFFER() -> uint256 { return uint256(7200); }

    // VERSION "1.0.0" built by hand (stringid.solc idiom): length word, then
    // the packed utf8 payload.
    public function VERSION() -> memory(string) {
        let ptr = allocate_memory(64);
        mstore(ptr, 5);
        mstore(ptr + 32, 0x312e302e30000000000000000000000000000000000000000000000000000000);
        return Typedef.abs(ptr) : memory(string);
    }

    public function getAllEvents() -> memory(DynArray(address)) {
        let count : word = Typedef.rep(Array.length(eventsArr));
        let ptr : word = allocate_memory((count + 1) * 32);
        mstore(ptr, count);
        for (let i : word = 0; i < count; i = i + 1) {
            mstore(ptr + 32 + i * 32, Typedef.rep(eventsArr[uint256(i)]));
        }
        return Typedef.abs(ptr) : memory(DynArray(address));
    }

    // --- validation (shared logic in lib.kodyl, byte-identical payloads) ---

    public function validateEventParameters(
        depositAmount : uint256,
        cancellationDeadline : uint256,
        eventStart : uint256,
        eventEnd : uint256,
        disputePeriod : uint256
    ) -> () {
        validateEventParams(depositAmount, cancellationDeadline, eventStart, eventEnd, disputePeriod);
    }

    // --- registry (replaces the deploying createEvent, deviation 1) ---

    // Registers an externally-deployed KodylEvent after re-reading and
    // re-validating its parameters through its own getters.
    public function registerEvent(evt : address) -> () {
        if (isKodylEventMap[evt]) {
            require(false, Error(shr(224, keccakLit("EventAlreadyRegistered()"))));
        }

        let dep = readUintFrom(evt, bytes32(keccakLit("depositAmount()")));
        let deadline = readUintFrom(evt, bytes32(keccakLit("cancellationDeadline()")));
        let start = readUintFrom(evt, bytes32(keccakLit("eventStart()")));
        let end_ = readUintFrom(evt, bytes32(keccakLit("eventEnd()")));
        let dispute = readUintFrom(evt, bytes32(keccakLit("disputePeriod()")));
        let org = readAddrFrom(evt, bytes32(keccakLit("organizer()")));

        validateEventParameters(dep, deadline, start, end_, dispute);

        ArrayPush.push(eventsArr, evt);
        isKodylEventMap[evt] = true;
        eventCount = eventCount + uint256(1); // unchecked in source

        // Protocol invariants (assert in source).
        solAssert(eventCount == Array.length(eventsArr));
        solAssert(isKodylEventMap[evt]);

        emitAddr2Amt3(keccakLit("EventCreated(address,address,uint256,uint256,uint256)"),
                      evt, org, dep, start, end_);
    }

    // --- maintainer management ---

    public function setMaintainer(newMaintainer : address) -> () {
        if (caller() != maintainer) {
            require(false, Error(shr(224, keccakLit("NotAuthorized()"))));
        }
        if (Typedef.rep(newMaintainer) == 0) {
            revertZeroAddress();
        }
        if (newMaintainer == maintainer) {
            // "Same maintainer"
            revertStr1(shr(224, keccakLit("InvalidEventParameters(string)")), 15,
                       0x53616d65206d61696e7461696e65720000000000000000000000000000000000);
        }

        let old = maintainer;
        maintainer = newMaintainer;

        solAssert(maintainer == newMaintainer);

        emitAddr2(keccakLit("MaintainerUpdated(address,address)"), old, newMaintainer);
    }
}
