// KodylEvent, ported from src/KodylEvent.sol to Core Solidity.
//
// The Foundry suite under test/unit is the behavioral oracle; test/core
// re-runs it against the bytecode this file compiles to. Deviations from the
// Solidity original are numbered and listed in core/README.md.
import std.{*};
import std.opcodes.{callvalue as callvalue_, shr, calldatasize, calldataload};
import std.dispatch.{*};
import std.Generic.{*};
import std.StorageGeneric.{*};
import lib.kodyl.{*};

// --- ADTs ---

// Lifecycle state, derived from timestamps (never stored).
data State = Registration | Active | Dispute | Settled | Cancelled;

// Stored per attendee. None is declared first so an unset mapping key (the
// all-zero slot pattern) reads back as None, matching Solidity's enum default.
data AttendeeStatus = None | Registered | Cancelled | CheckedIn | Claimed;

// --- ADT ordinals ---

function stateOrd(s : State) -> uint256 {
    match s {
    | State.Registration => return uint256(0);
    | State.Active       => return uint256(1);
    | State.Dispute      => return uint256(2);
    | State.Settled      => return uint256(3);
    | State.Cancelled    => return uint256(4);
    }
}

function statusOrd(s : AttendeeStatus) -> uint256 {
    match s {
    | AttendeeStatus.None       => return uint256(0);
    | AttendeeStatus.Registered => return uint256(1);
    | AttendeeStatus.Cancelled  => return uint256(2);
    | AttendeeStatus.CheckedIn  => return uint256(3);
    | AttendeeStatus.Claimed    => return uint256(4);
    }
}

// Cross-contract read of IKodylFactory(f).maintainer() (deviation 7).
function readMaintainer(f : address) -> address {
    return address(readWordFrom(f, bytes32(keccakLit("maintainer()"))));
}

contract KodylEvent {
    // Declaration order = slot order. Mirrors the Solidity field order.
    factory : address;
    organizer : address;
    depositAmount : uint256;
    cancellationDeadline : uint256;
    eventStart : uint256;
    eventEnd : uint256;
    disputePeriod : uint256;
    maxAttendees : uint256;
    metadataURI : string;
    cancelled : bool;
    // Named attendeeStatus (not attendees) so the public getter attendees()
    // never has to index a field sharing its own name.
    attendeeStatus : mapping(address, AttendeeStatus);
    registeredCount : uint256;
    checkedInCount : uint256;
    claimedCount : uint256;

    constructor(
        factory_ : address,
        organizer_ : address,
        depositAmount_ : uint256,
        cancellationDeadline_ : uint256,
        eventStart_ : uint256,
        eventEnd_ : uint256,
        disputePeriod_ : uint256,
        maxAttendees_ : uint256,
        metadataURI_ : memory(string)
    ) {
        factory = factory_;
        organizer = organizer_;
        depositAmount = depositAmount_;
        cancellationDeadline = cancellationDeadline_;
        eventStart = eventStart_;
        eventEnd = eventEnd_;
        disputePeriod = disputePeriod_;
        maxAttendees = maxAttendees_;
        metadataURI = metadataURI_;
    }

    // --- state derivation ---

    // Mirrors src/KodylEvent.sol getState(): state is derived from timestamps,
    // never stored. Internal (non-public = not dispatched).
    function currentState() -> State {
        if (cancelled) { return State.Cancelled; }
        let t = timeNow();
        if (t < eventStart) { return State.Registration; }
        if (t <= eventEnd) { return State.Active; }
        if (t <= addCk(eventEnd, disputePeriod)) { return State.Dispute; }
        return State.Settled;
    }

    // ABI surface returns the enum ordinal, wire-identical to Solidity's
    // enum return encoding.
    public function getState() -> uint256 {
        return stateOrd(currentState());
    }

    public function attendees(a : address) -> uint256 {
        return statusOrd(attendeeStatus[a]);
    }

    // --- attendee functions ---

    // Guard order and effect order mirror src/KodylEvent.sol register().
    public payable function register() -> () {
        if (stateOrd(currentState()) != uint256(0)) {
            require(false, Error(shr(224, keccakLit("RegistrationClosed()"))));
        }
        let st = statusOrd(attendeeStatus[caller()]);
        if (st == uint256(1)) {
            require(false, Error(shr(224, keccakLit("AlreadyRegistered()"))));
        }
        if (st == uint256(4)) {
            // Source passes (Claimed, None) here.
            revertWith2(shr(224, keccakLit("InvalidAttendeeStatus(uint8,uint8)")), 4, 0);
        }
        if (caller_value() != depositAmount) {
            revertWith2(shr(224, keccakLit("IncorrectDeposit(uint256,uint256)")),
                        Typedef.rep(depositAmount), Typedef.rep(caller_value()));
        }
        // Strict (non-short-circuit) && is safe here: both operands are pure.
        if (maxAttendees > uint256(0) && registeredCount >= maxAttendees) {
            require(false, Error(shr(224, keccakLit("EventFull()"))));
        }

        attendeeStatus[caller()] = AttendeeStatus.Registered;
        registeredCount = registeredCount + uint256(1); // unchecked in source

        // Deposit accounting invariant (assert in source = Panic on failure).
        solAssert(balanceSelf() == mulCk(registeredCount, depositAmount));

        emitAddr(keccakLit("Registered(address)"), caller());
    }

    public function cancel() -> () {
        if (timeNow() > cancellationDeadline) {
            require(false, Error(shr(224, keccakLit("CancellationDeadlinePassed()"))));
        }
        let st = statusOrd(attendeeStatus[caller()]);
        if (st != uint256(1)) {
            revertWith2(shr(224, keccakLit("InvalidAttendeeStatus(uint8,uint8)")),
                        Typedef.rep(st), 1);
        }

        attendeeStatus[caller()] = AttendeeStatus.Cancelled;
        registeredCount = registeredCount - uint256(1); // unchecked in source

        sendValue(caller(), depositAmount);

        solAssert(balanceSelf() == mulCk(registeredCount, depositAmount));

        emitAddr(keccakLit("RegistrationCancelled(address)"), caller());
    }

    // Refund path for organizer-cancelled events (the bug fix ported from
    // src/KodylEvent.sol claimRefund()).
    public function claimRefund() -> () {
        if (!cancelled) {
            require(false, Error(shr(224, keccakLit("EventNotCancelled()"))));
        }
        let st = statusOrd(attendeeStatus[caller()]);
        if (st != uint256(1)) {
            revertWith2(shr(224, keccakLit("InvalidAttendeeStatus(uint8,uint8)")),
                        Typedef.rep(st), 1);
        }

        attendeeStatus[caller()] = AttendeeStatus.Cancelled;
        registeredCount = registeredCount - uint256(1); // unchecked in source

        sendValue(caller(), depositAmount);

        solAssert(balanceSelf() == mulCk(registeredCount, depositAmount));

        emitAddrAmt(keccakLit("RefundClaimed(address,uint256)"), caller(), depositAmount);
    }

    // Pro-rata share of forfeited no-show deposits per checked-in attendee
    // (src/KodylEvent.sol _calculateReward). Division is guarded by the zero
    // check; sub/mul were checked in the source, hence the shims.
    function calcReward() -> uint256 {
        if (checkedInCount == uint256(0)) { return uint256(0); }
        let noShow = subCk(registeredCount, checkedInCount);
        let totalForfeited = mulCk(noShow, depositAmount);
        return totalForfeited / checkedInCount;
    }

    public function rewardPerAttendee() -> uint256 {
        return calcReward();
    }

    public function claim() -> () {
        if (stateOrd(currentState()) != uint256(3)) {
            require(false, Error(shr(224, keccakLit("NotSettled()"))));
        }
        let st = statusOrd(attendeeStatus[caller()]);
        if (st != uint256(3)) {
            revertWith2(shr(224, keccakLit("InvalidAttendeeStatus(uint8,uint8)")),
                        Typedef.rep(st), 3);
        }

        attendeeStatus[caller()] = AttendeeStatus.Claimed;
        claimedCount = claimedCount + uint256(1); // unchecked in source

        let payout = addCk(depositAmount, calcReward());

        sendValue(caller(), payout);

        emitAddrAmt(keccakLit("Claimed(address,uint256)"), caller(), payout);
    }

    // --- organizer functions ---

    function onlyOrganizer() -> () {
        if (caller() != organizer) {
            require(false, Error(shr(224, keccakLit("NotOrganizer()"))));
        }
    }

    // Shared check-in logic (src/KodylEvent.sol _checkIn): silently skips
    // anyone not currently Registered so batches can tolerate invalid entries.
    function checkInInner(a : address) -> () {
        let t = timeNow();
        if (t < eventStart || t > addCk(eventEnd, disputePeriod)) {
            require(false, Error(shr(224, keccakLit("CheckInWindowClosed()"))));
        }
        let st = statusOrd(attendeeStatus[a]);
        if (st == uint256(1)) {
            attendeeStatus[a] = AttendeeStatus.CheckedIn;
            checkedInCount = checkedInCount + uint256(1); // unchecked in source
            emitAddr(keccakLit("CheckedIn(address)"), a);
        }
    }

    public function checkIn(a : address) -> () {
        onlyOrganizer();
        checkInInner(a);
    }

    public function setMetadataURI(newUri : memory(string)) -> () {
        onlyOrganizer();
        metadataURI = newUri;
        emitStr(keccakLit("MetadataUpdated(string)"), newUri);
    }

    public function cancelEvent() -> () {
        onlyOrganizer();
        if (stateOrd(currentState()) != uint256(0)) {
            require(false, Error(shr(224, keccakLit("EventAlreadyStarted()"))));
        }
        if (cancelled) {
            // Source quirk preserved: passes (AttendeeStatus.Cancelled, None).
            revertWith2(shr(224, keccakLit("InvalidAttendeeStatus(uint8,uint8)")), 2, 0);
        }

        cancelled = true;

        emitBare(keccakLit("EventCancelled()"));
    }

    // --- parameter getters (selector-compatible with Solidity's auto-getters) ---

    public function factory() -> address { return factory; }
    public function organizer() -> address { return organizer; }
    public function depositAmount() -> uint256 { return depositAmount; }
    public function cancellationDeadline() -> uint256 { return cancellationDeadline; }
    public function eventStart() -> uint256 { return eventStart; }
    public function eventEnd() -> uint256 { return eventEnd; }
    public function disputePeriod() -> uint256 { return disputePeriod; }
    public function maxAttendees() -> uint256 { return maxAttendees; }
    public function metadataURI() -> memory(string) { return metadataURI; }
    public function cancelled() -> bool { return cancelled; }
    public function registeredCount() -> uint256 { return registeredCount; }
    public function checkedInCount() -> uint256 { return checkedInCount; }
    public function claimedCount() -> uint256 { return claimedCount; }

    // Constants become functions: no constant keyword or time-unit sugar in
    // Core Solidity (deviation 8). 2592000 = 30 days in seconds.
    public function MAX_BATCH_SIZE() -> uint256 { return uint256(100); }
    public function DUST_CLAIM_TIMEOUT() -> uint256 { return uint256(2592000); }

    // --- dust ---

    public function claimDust() -> () {
        if (stateOrd(currentState()) != uint256(3)) {
            require(false, Error(shr(224, keccakLit("NotSettled()"))));
        }
        if (cancelled) {
            // Source: cancelled events never yield dust (kept for structural
            // parity; unreachable since cancelled implies state Cancelled).
            require(false, Error(shr(224, keccakLit("NotSettled()"))));
        }

        let allClaimed = claimedCount == checkedInCount;
        let timeoutPassed = timeNow() > addCk(addCk(eventEnd, disputePeriod), uint256(2592000));
        if (!allClaimed && !timeoutPassed) {
            require(false, Error(shr(224, keccakLit("DustNotClaimable()"))));
        }

        let dust = balanceSelf();
        if (dust == uint256(0)) {
            require(false, Error(shr(224, keccakLit("DustNotClaimable()"))));
        }

        let m = readMaintainer(factory);

        sendValue(m, dust);

        emitAddrAmt(keccakLit("DustClaimed(address,uint256)"), m, dust);

        solAssert(balanceSelf() == uint256(0));
    }

    // --- fallback: receive() emulation + checkInBatch manual dispatch ---

    // checkInBatch(address[]) cannot be a typed public function: the std ABI
    // decoder for dynamic arrays is a stub. The calldata is decoded by hand
    // here instead - same selector, same ordering, same skip semantics, same
    // revert payloads (deviation 2).
    function checkInBatchImpl() -> () {
        onlyOrganizer();
        let lenPtr = 4 + calldataload(4); // head word holds the array offset
        let len = calldataload(lenPtr);
        if (len > 100) {
            revertWith2(shr(224, keccakLit("BatchTooLarge(uint256,uint256)")), len, 100);
        }
        for (let i : word = 0; i < len; i = i + 1) {
            checkInInner(address(calldataload(lenPtr + 32 + i * 32)));
        }
    }

    // The language has no receive() yet; empty calldata routes here. Solidity
    // KodylEvent behavior reproduced: empty calldata reverts TransferFailed
    // (its receive() rejects ETH), unknown selectors revert with no data
    // (deviation 3).
    payable fallback() -> () {
        let sz = calldatasize();
        if (sz == 0) {
            require(false, Error(shr(224, keccakLit("TransferFailed()"))));
        }
        if (sz >= 4) {
            if (shr(224, calldataload(0)) == shr(224, keccakLit("checkInBatch(address[])"))) {
                if (callvalue_() != 0) {
                    revertEmpty(); // Solidity non-payable with value: empty revert
                }
                checkInBatchImpl();
                return ();
            }
        }
        revertEmpty();
    }
}
